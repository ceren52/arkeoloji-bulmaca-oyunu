{
  "name": "golge-tapinagi",
  "version": "0.1.0",
  "private": true,
  "description": "Shadow Temple archaeological puzzle game",
  "main": "electron-main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.ceren.shadowtemple",
    "productName": "Shadow Temple",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!release/**",
      "!.npm-cache/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
